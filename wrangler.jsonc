/**
 * Cloudflare Workers configuration.
 *
 * The store runs on Workers via @opennextjs/cloudflare. Two things matter here:
 *
 *  - `nodejs_compat` — lib/download-token.ts uses node:crypto for HMAC signing.
 *  - the DOWNLOADS R2 bucket — Workers has no filesystem, so the product PDFs
 *    live in object storage and are streamed by app/api/download after the
 *    purchase is verified. R2 is private by default; do not attach a public
 *    bucket URL to it, or the whole paywall is bypassed.
 *
 * Secrets are NOT set here. Use `wrangler secret put <NAME>` — see docs/RUNBOOK.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bba-network-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // The store answers on guides.bbanetwork.org.
  //
  // It used to answer on the apex, and this block used to claim `bbanetwork.org`
  // and `www.bbanetwork.org`. On 2026-08-24 the apex was reattached to
  // `bba-network-hub` (Project 6) in the Cloudflare dashboard, and the store
  // moved to `guides.`. This file was not updated at the time, and the store has
  // not been deployed since — so the stale claim never fired.
  //
  // Leaving it would have meant one of two things on the next deploy, both bad:
  // wrangler takes the apex back off the hub, or the deploy fails outright.
  // Project 6's `src/redirects.ts` sends every legacy apex URL here, so the two
  // repos now agree on which host serves what.
  //
  // Do not add `www.bbanetwork.org` here. It belongs to the hub, which serves
  // the brand page — see web-6/docs/DOMAINS.md.
  "routes": [
    { "pattern": "guides.bbanetwork.org", "custom_domain": true }
  ],

  // Explicit because wrangler defaults this to FALSE as soon as `routes` exists,
  // which would take the workers.dev address down with the same deploy that
  // brings the domain up. The Stripe webhook endpoint still points there, so
  // losing it silently means paid orders stop being delivered.
  "workers_dev": true,

  // Do not delete variables that were added in the Cloudflare dashboard but are
  // absent from this file. Without this, `wrangler deploy` silently wipes them,
  // so anything configured through the UI vanishes on the next deploy.
  // Secrets are preserved either way — this only protects plain-text vars.
  "keep_vars": true,

  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "bba-network-downloads",
      "preview_bucket_name": "bba-network-downloads-preview"
    }
  ],

  "vars": {
    // Public, non-secret values only. Anything sensitive goes in `wrangler secret put`.
    "NEXT_PUBLIC_SITE_URL": "https://guides.bbanetwork.org",
    "STRIPE_AUTOMATIC_TAX": "false"
  }
}
