# ---------------------------------------------------------------------------
# Local development only.
#
#   next dev        reads .env.local
#   wrangler dev    reads .dev.vars (same keys, same values — see below)
#
# In production NOTHING here is used. Secrets go in with `wrangler secret put`
# and public values live in the `vars` block of wrangler.jsonc.
# See docs/RUNBOOK.md.
#
# This file is the .dev.vars template used by `wrangler dev`.
# Copy to .dev.vars. Never commit it.
# ---------------------------------------------------------------------------

# Stripe — dashboard.stripe.com/apikeys
# Use the test key (sk_test_...) until you have run a full test purchase.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret.
#   local:      npm run stripe:listen  (prints a whsec_... to use here)
#   deployed:   dashboard.stripe.com/webhooks -> add endpoint
#               <your-domain>/api/stripe/webhook
#               events: checkout.session.completed,
#                       checkout.session.async_payment_succeeded,
#                       checkout.session.async_payment_failed,
#                       charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Tax. Leave false until tax registrations are set up in the dashboard.
STRIPE_AUTOMATIC_TAX=false

# Signs download links. At least 32 characters.
#   openssl rand -base64 32
# Rotating this invalidates every link already sent out.
DOWNLOAD_SIGNING_SECRET=

# Public origin, no trailing slash. Used for success/cancel URLs and the
# absolute download links in the delivery email.
# In production this is set in wrangler.jsonc `vars`, not as a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery email (optional). Without these the store still works — the success
# page shows the links — but no email is sent.
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=

# Agent tooling (optional) — see docs/AGENTS.md
FIRECRAWL_API_KEY=
